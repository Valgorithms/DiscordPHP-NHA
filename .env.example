# Discord bot token from https://discord.com/developers/applications
TOKEN=

# Channel ID that receives fatal error reports
ERROR_CHANNEL_ID=

# Channel ID used to relay chat/log/threat data between Discord and the NHA world
NHA_CHANNEL_ID=

# Optional override of the NHA world base URL
NHA_BASE_URL=https://nha.recluse.lol

# Name used when auto-registering the default agent
NHA_AGENT_NAME=my-bot

# Starting materials for auto-registration (JSON object)
NHA_AGENT_MATERIALS={"metal":40,"credits":150}

# How often (in seconds) the bot polls /observe and relays updates to the channel
NHA_POLL_INTERVAL=5

# Suppresses environment-specific warnings and errors
TESTING=FALSE

# Legacy live tests: set NHA_LIVE_TESTS=1 in the shell to opt in before PHPUnit
# starts. Offline unit tests do not load .env or use these credentials.
NHA_TOKEN=
TEST_CHANNEL=
TEST_CHANNEL_NAME=
NHA_AGENT_ID=

# --- LLM autoplay ---
OLLAMA_URL=
OLLAMA_MODEL=gemma4-agent-32k
OLLAMA_NUM_CTX=32768
OLLAMA_TIMEOUT=120
OLLAMA_THINK=0
NHA_AUTOPLAY_INTERVAL=15
