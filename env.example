# DiscordPHP-NHA configuration. Copy to `.env` in the project directory and
# fill in what you use:   cp env.example .env
#
# Only placeholders here; never commit a real token. A variable already set in
# the environment wins over `.env`. Comments must be on their own line: the
# loaders read everything after `=` as the value.

# --- Discord (bot.php) ---------------------------------------------------------

# Discord bot token. Required for bot.php.
TOKEN=
# Channel for the two-way Discord <-> world relay and the controls. Optional.
NHA_CHANNEL_ID=
# Separate channel for the autoplay play-by-play. Optional; defaults to NHA_CHANNEL_ID.
NHA_BRAIN_CHANNEL_ID=
# Channel that receives unhandled errors. Optional.
ERROR_CHANNEL_ID=
# Relay poll interval, in seconds.
NHA_POLL_INTERVAL=5

# --- NHA world -------------------------------------------------------------------

# Override the NHA API base URL. Optional; empty = the public server.
NHA_BASE_URL=
# Agent action token for autoplay.php. Optional; empty = the one saved in var/state.json.
NHA_TOKEN=

# --- LLM brain (Ollama) ------------------------------------------------------------

# Enables the brain. A bare origin (http://localhost:11434) uses Ollama's native
# API; a trailing /v1 (http://localhost:11434/v1) uses the OpenAI-compatible one.
# Empty = no brain (bot.php runs without autoplay; autoplay.php refuses to start).
OLLAMA_URL=
# A tag from `ollama list` on that server.
OLLAMA_MODEL=gemma3:27b
# Context window to request, in tokens (native mode only).
OLLAMA_NUM_CTX=32768
# Per-request timeout, in seconds.
OLLAMA_TIMEOUT=120
# 0 skips a thinking model's reasoning pass, 1 forces it; empty = the model's default.
OLLAMA_THINK=

# --- Autoplay ----------------------------------------------------------------------

# bot.php: 0 leaves the loop's saved on/off flag alone; empty or 1 turns it on at boot.
NHA_AUTOPLAY=
# Seconds between turns. Raise it for a slow local model.
NHA_AUTOPLAY_INTERVAL=15
# autoplay.php: 1 = decide and print each turn, but never submit the intent.
NHA_AUTOPLAY_DRY=
# 0 turns off the strategist (the occasional goal-and-steps plan); empty = on.
NHA_PLANNER=

# --- Tests (live integration only; unit tests need none of this) --------------------

# A Discord channel id the live tests may post in.
TEST_CHANNEL=
