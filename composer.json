{
    "name": "discord-php-extended/discordphp-nha",
    "description": "API Library and Discord bot for the NHA (https://nha.recluse.lol) agent sandbox, built on top of DiscordPHP.",
    "keywords": [
        "discord",
        "discordphp",
        "nha",
        "no-human-allowed",
        "agent",
        "bot",
        "reactphp",
        "api-client"
    ],
    "homepage": "https://github.com/discord-php/DiscordPHP-NHA",
    "license": "MIT",
    "authors": [
        {
            "name": "Valithor Obsidion",
            "email": "valithor@discordphp.org"
        }
    ],
    "support": {
        "issues": "https://github.com/discord-php/DiscordPHP-NHA/issues",
        "source": "https://github.com/discord-php/DiscordPHP-NHA",
        "docs": "https://nha.recluse.lol/docs"
    },
    "require": {
        "php": "^8.3",
        "team-reflex/discord-php": "dev-master",
        "discord-php/http": "dev-master as 10.9.8",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3",
        "phpunit/phpunit": "^9.4.4",
        "laravel/pint": "^1.21",
        "wyrihaximus/react-cache-redis": "^4.5",
        "phpacker/phpacker": "^0.6.4",
        "symfony/console": "^7.4"
    },
    "scripts": {
        "pint": [
            "./vendor/bin/pint --config ./pint.json ./src"
        ],
        "cs": "php-cs-fixer fix",
        "cs-unsupported": "php-cs-fixer fix --allow-unsupported-php-version yes",
        "unit": "phpunit",
        "phpacker": [
            "@phpacker:bot",
            "@phpacker:autoplay"
        ],
        "phpacker:bot": "phpacker build --src=bot.php --dest=bin/build/bot",
        "phpacker:autoplay": "phpacker build --src=autoplay.php --dest=bin/build/autoplay",
        "upstream:check": "php upstream-watch.php",
        "upstream:accept": "php upstream-watch.php --accept"
    },
    "scripts-descriptions": {
        "phpacker": "Build standalone binaries for both entry points (bot.php and autoplay.php).",
        "phpacker:bot": "Build a standalone binary for the Discord bot (bot.php) into bin/build/bot.",
        "phpacker:autoplay": "Build a standalone binary for the headless autoplay runner (autoplay.php) into bin/build/autoplay.",
        "upstream:check": "Compare the live NHA server with the baseline this code was written against; exit 1 if it moved.",
        "upstream:accept": "Take the live NHA server as the new baseline (upstream/*.json, openapi.json)."
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "NHA\\": "src/NHA/",
            "Tests\\": "tests/"
        }
    }
}
